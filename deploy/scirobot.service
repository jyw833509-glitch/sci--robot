; ============================================================
;  systemd 服务单元（Linux 常驻定时模式）
;  安装：
;    sudo cp deploy/scirobot.service /etc/systemd/system/
;    sudo systemctl daemon-reload
;    sudo systemctl enable --now scirobot
;  查看日志：
;    journalctl -u scirobot -f
;  注意：请把 User / WorkingDirectory / ExecStart 改成实际路径
; ============================================================

[Unit]
Description=SciRobot Literature Push Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/scirobot
Environment="TZ=Asia/Shanghai"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/scirobot/.venv/bin/python /opt/scirobot/main.py schedule
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
